generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  ARTIST
  USER
  COMMANDER
  ARQUITECTO
  FLEET_OPERATOR
  OPERADOR
  PROVIDER
  EXPLORADOR
  CLIENT
  AFFILIATE
}

enum WaybillStatus {
  PENDING
  QUEUED
  DISPATCHED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum WaybillParticipantRole {
  DRIVER
  ARTIST
  CLIENT
  MANAGER
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum ClaimStatus {
  GHOST_UNCLAIMED
  CLAIMED_PENDING_VERIFICATION
  VERIFIED_ACTIVE
}

enum VendorCategory {
  FINCA_ALQUILER
  CATERING
  DJ_DISCOMOVIL
  BARRA_LIBRE
  FOTOGRAFIA_VIDEO
  FLORISTERIA
  TRANSPORTE_AUTOBUS
  DECORACION_ILUMINACION
}

// ==========================================
// MODELOS CORE Y RELACIONES
// ==========================================

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  displayName       String?
  role              Role               @default(USER)
  rank              String?
  artistProfile     artistProfile?
  clientProfile     clientProfile?
  auraWallet        auraWallet?
  commissionLedgers commissionLedger[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model artistProfile {
  id          String           @id @default(cuid())
  userId      String           @unique
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String?          @unique
  stageName   String?
  displayName String?
  bio         String?
  status      String?          @default("PUBLISHED")
  genres      String[]
  riders      technicalRider[]
  waybills    waybill[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model technicalRider {
  id              String         @id @default(cuid())
  artistProfileId String?
  artistProfile   artistProfile? @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  artistId        String?
  title           String?
  version         Int            @default(1)
  content         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([artistProfileId, version], name: "artistProfileId_version")
  @@unique([artistId, version], name: "artistId_version")
}

model clientProfile {
  id          String          @id @default(cuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  waybills    waybill[]
  contracts   smartContract[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model auraWallet {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Float         @default(0.0)
  currency      String        @default("EUR")
  walletAddress String?
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId], name: "idx_wallet_user")
}

model Transaction {
  id          String     @id @default(cuid())
  walletId    String
  wallet      auraWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        String
  description String?
  createdAt   DateTime   @default(now())

  @@index([walletId], name: "idx_transaction_wallet")
}

model commissionLedger {
  id          String           @id @default(cuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id])
  amount      Float
  currency    String           @default("EUR")
  status      CommissionStatus @default(PENDING)
  reference   String?
  sourceEvent String?
  description String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model smartContract {
  id              String         @id @default(cuid())
  title           String?
  artistId        String?
  userId          String?
  clientProfileId String?
  clientProfile   clientProfile? @relation(fields: [clientProfileId], references: [id])
  workspaceId     String?
  workspace       workspace?     @relation(fields: [workspaceId], references: [id])
  stripeSessionId String?
  deposit         Float?
  contractTerms   String?
  signedAt        DateTime?
  status          String         @default("DRAFT")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model waybill {
  id                String           @id @default(cuid())
  referenceCode     String?          @unique
  bookingId         String?
  status            WaybillStatus    @default(PENDING)
  originLabel       String?
  originLat         Float?
  originLng         Float?
  destinationLabel  String?
  destination       String?
  destinationLat    Float?
  destinationLng    Float?
  distanceMeters    Float?
  startsAt          DateTime?
  notes             String?
  artistProfileId   String?
  artistProfile     artistProfile?   @relation(fields: [artistProfileId], references: [id])
  providerProfileId String?
  providerProfile   providerProfile? @relation(fields: [providerProfileId], references: [id])
  clientProfileId   String?
  clientProfile     clientProfile?   @relation(fields: [clientProfileId], references: [id])
  unitId            String?
  unit              fleetUnit?       @relation(fields: [unitId], references: [id])
  workspaceId       String?
  workspace         workspace?       @relation(fields: [workspaceId], references: [id])
  items             WaybillItem[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model WaybillItem {
  id        String   @id @default(cuid())
  waybillId String
  waybill   waybill  @relation(fields: [waybillId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int      @default(1)

  @@index([waybillId], name: "idx_waybill_item")
}

model providerProfile {
  id                   String         @id @default(cuid())
  slug String? @unique
  name                 String?        @unique
  companyName          String?        @default("")
  category             VendorCategory @default(FINCA_ALQUILER)
  city                 String?
  location             String?
  phone                String?
  email                String?
  userId               String?        @unique
  stripeAccountId      String?
  isVerified           Boolean        @default(false)
  roiGuaranteeScore    Float?         @default(0.0)
  roiProjected         Float?         @default(0.0)
  technicalReliability Float?         @default(0.0)
  auraLevel            Float?         @default(0.0)
  claimStatus          ClaimStatus    @default(GHOST_UNCLAIMED)
  claimToken           String?        @unique
  waybills             waybill[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([category], name: "idx_provider_category")
}

model workspace {
  id             String          @id @default(cuid())
  slug           String?         @unique
  name           String?
  fleetUnits     fleetUnit[]
  waybills       waybill[]
  smartContracts smartContract[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model fleetUnit {
  id              String     @id @default(cuid())
  unitCode        String?    @unique
  code            String?    @unique
  status          String     @default("IDLE")
  currentLocation String?
  workspaceId     String?
  workspace       workspace? @relation(fields: [workspaceId], references: [id])
  waybills        waybill[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model fleetTelemetryEvent {
  id        String   @id @default(cuid())
  unitId    String?
  eventData String?
  createdAt DateTime @default(now())
}

model calendarBlock {
  id              String    @id @default(cuid())
  artistProfileId String?
  date            DateTime?
  createdAt       DateTime  @default(now())
}

model VendorShadowProfile {
  id              String   @id @default(uuid())
  slug            String   @unique
  rawName         String
  description     String?
  extractedImages String[]
  claimToken      String   @unique
  isClaimed       Boolean  @default(false)
  sourceOrigin    String   @default("PARSED_LOCAL")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EquipmentInventory {
  id             String   @id @default(uuid())
  modelName      String   // Ej: "Bose F1 Model 812"
  serialNumber   String   @unique
  category       String   // SOUND_PA, MIXER, MICROPHONE, LIGHTING
  isAvailable    Boolean  @default(true)
  suitableForPax Int      @default(300)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}