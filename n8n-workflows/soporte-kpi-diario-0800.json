{
    "name": "SOPORTE · KPI Ejecutivo Diario 08:00 (S-Class)",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 8 * * *"
                        }
                    ]
                }
            },
            "id": "cron-0800",
            "name": "Cron 08:00 Madrid",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "url": "={{ $env.EAR_KPI_URL }}",
                "options": {
                    "timeout": 20000
                },
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "=Bearer {{ $env.CRON_SECRET }}"
                        }
                    ]
                }
            },
            "id": "http-kpi",
            "name": "Obtener KPIs",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                220,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "const k = $input.first().json;\nconst rows = [];\nfor (const [key, value] of Object.entries(k)) {\n  rows.push(`▪️ ${key}: ${value}`);\n}\nreturn [{ summary: `📊 *KPI EJECUTIVO EAR OS — ${new Date().toLocaleDateString('es-ES')}*\\n\\n${rows.join('\\n')}` }];"
            },
            "id": "code-format",
            "name": "Formatear resumen",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                0
            ]
        },
        {
            "parameters": {
                "content": "={{ $json.summary }}",
                "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
                "additionalFields": {}
            },
            "id": "telegram-kpi",
            "name": "Enviar a Telegram",
            "type": "n8n-nodes-base.telegram",
            "typeVersion": 1.2,
            "position": [
                660,
                0
            ],
            "credentials": {
                "telegramApi": {
                    "id": "telegram-cred",
                    "name": "Telegram Account"
                }
            }
        }
    ],
    "connections": {
        "Cron 08:00 Madrid": {
            "main": [
                [
                    {
                        "node": "Obtener KPIs",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Obtener KPIs": {
            "main": [
                [
                    {
                        "node": "Formatear resumen",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Formatear resumen": {
            "main": [
                [
                    {
                        "node": "Enviar a Telegram",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1",
        "timezone": "Europe/Madrid"
    },
    "pinData": {}
}