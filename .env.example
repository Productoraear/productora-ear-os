# ══════════════════════════════════════════════════════════════════════════════
# OPPORTUNITY RADAR — CAZA DE OPORTUNIDADES REALES (Google Alerts + RSS + TED)
# ══════════════════════════════════════════════════════════════════════════════
# Secreto que protege los endpoints /api/cron/* (Bearer Token).
CRON_SECRET=your_cron_secret_here

# Clave de suscripción de TED API v3 (licitaciones UE reales).
# Solicítala en https://developer.ted.europa.eu/ (gratuita con límites).
# Sin esta clave, el radar de licitaciones B2G queda FAIL-CLOSED (0 avisos, nunca fabrica).
TED_API_KEY=your_ted_api_key_here

# URLs de feeds RSS de Google Alerts, separadas por comas.
# Crea una alerta en https://www.google.es/alerts y copia su "Feed RSS".
# Ejemplos de alertas recomendadas (una por línea lógica):
#   "convocatoria artistas 2026", "subvenciones música ayuntamiento",
#   "pleno municipal festejos", "concurso proyectos culturales",
#   "comisión de fiestas contratación artistas", "servicios sociales mayores musicoterapia"
GOOGLE_ALERTS_RSS=https://www.google.com/alerts/feeds/ALERT_ID/UNIQUE_ID

# Catálogo JSON de feeds RSS/Atom públicos (BOE, sedes electrónicas, municipios).
# Formato: array de strings (URL) o de objetos { "url", "name", "source" }.
# OPPORTUNITY_RADAR_FEEDS=[{"url":"https://.../feed.xml","name":"BOE subvenciones","source":"RSS_FEED"}]
