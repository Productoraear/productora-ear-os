					$(document).ready(function()
					{
						$("*[src-colorbox]").each(function(){
							$this = $(this);
							
							$src = $this.attr('src');
							if($src != 'NA')
							{
								$('<img/>')[0].src = $src; //preload image
							}
							
							$srcColorbox = $this.attr('src-colorbox');
							
							if($srcColorbox != 'NA')
							{
								$('<img/>')[0].src = $srcColorbox; //preload image
							}
						});
