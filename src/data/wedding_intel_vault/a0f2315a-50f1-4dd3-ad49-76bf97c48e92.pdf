<script>
  $(document).on("click",".btn-open-product", function () {
    $('a[data-c-product_id="' + $(this).data('product_id') + '"]')[0].click();
  });
  $(document).on("mouseover",".swatch-icon", function () {
    let src = $('a[data-c-product_id="' + $(this).data('product_id') + '"] img').attr('src').replace(/_.*-/,'_' + $(this).data('id') + '-');
    let srcset = $('a[data-c-product_id="' + $(this).data('product_id') + '"] img').attr('srcset').replace(/_.*-/,'_' + $(this).data('id') + '-');
    $('a[data-c-product_id="' + $(this).data('product_id') + '"] img').attr('src',src);
    $('a[data-c-product_id="' + $(this).data('product_id') + '"] img').attr('srcset',srcset);
    
    let href = $('a[data-c-product_id="' + $(this).data('product_id') + '"]').attr('href').replace(/color=.*&/,'color=' + $(this).data('id') + '&');
    if(!href.includes('color=')){
      href = href.concat('&color=' + $(this).data('id') + '&') 
    }
    $('a[data-c-product_id="' + $(this).data('product_id') + '"]').attr('href', href);
  });
</script>
