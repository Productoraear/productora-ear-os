4_1_122591.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3307_1_122591-1552402933.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3426_1_122591-1552402916.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3427_1_122591-1552402917.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3430_1_122591-1552402919.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3431_1_122591-1552402917.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3433_1_122591-1552402940.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3437_1_122591-1552402931.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3735_1_122591-1552402935.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3748_1_122591-1552402943.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3750_1_122591-1552402940.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3751_1_122591-1552402941.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/img-3783_1_122591-1552402951.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/2a9f6713-ac47-4918-a360-931afdfb37cd_1_122591-1559057412.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/2bbc5da8-fc1b-4871-852f-9d75e71d5fdb_1_122591-1559057413.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/5b0b825c-620f-48dd-97bb-dddc3d695a1f_1_122591-1559057413.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/6c7760b4-845c-46bf-9950-55437dece762_1_122591-1559057412.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/7ea8717e-6ac5-48f0-a988-dcf23b4ef642_1_122591-1559057413.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/9f762d16-951f-4715-9b90-eca9e86a5a90_1_122591-1559057417.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/38e7df7b-2cb3-4994-b2c1-eeffe8d987bf_1_122591-1559057418.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/22591\/3_2\/960\/jpg\/99ad0354-07ab-41bf-a029-fca9abb58f01_1_122591-1559057416.webp","width":960,"height":640}],"review":[{"@type":"Review","datePublished":"2024-10-12","description":"La Alquer\u00eda de Vilches es un lugar precioso, \u00edntimo y con bastante alojamiento. Ofrece la posibilidad de alargar la fiesta por tu cuenta una vez acaba la barra libre, ya que el espacio se tiene en exclusividad. Tiene cocina propia (la comida es rica), y la relaci\u00f3n calidad precio no est\u00e1 mal. Todo esto fue lo que nos hizo decidirnos por este lugar. Mi chico y yo proyectamos y nos curramos nuestra boda porque sab\u00edamos bien lo que quer\u00edamos. Mis pegas son: 1. Nico tiene muy malos modos a veces. Tuvo un par de detalles muy feos, tanto durante la organizaci\u00f3n de la boda como en el transcurso de la misma. Esto no quita que haya tenido bastante disponibilidad durante la organizaci\u00f3n, y que en algunas cosas finalmente se haya portado. Pero con esos malos modos pierde mucha profesionalidad. 2. Nosotros tenemos un hijo, as\u00ed que pensamos en los ni\u00f1os y en lo que es mejor para ellos. Se nota cuando los organizadores no tienen hijos, porque no prestan mucha atenci\u00f3n a facilitar las cosas para ellos. 3. Los invitados coincidieron en que el servicio durante la comida no era muy bueno, en el sentido de que hab\u00eda que estar detr\u00e1s para que trajeran vino\/bebidas. Isa, la DJ, es la mejor del equipo. Trabajar con ella y con su chico da gusto. Tuvo una gran disposici\u00f3n por hacerlo todo a nuestro gusto a pesar de que para ella pudiera suponer, quiz\u00e1s, m\u00e1s trabajo. Fue un lujo y un placer tenerla!! \u00c1gatha hizo un gran trabajo con la decoraci\u00f3n de la ceremonia. Aunque algo importante para nosotros, que eran unas banderillas que yo misma hab\u00eda comprado, tuvimos que ponerlas nosotros mismos. Tambi\u00e9n hizo la labor de estar pendiente de recibir a quienes ven\u00edan a lo largo de la boda: los grupos de m\u00fasica, la animaci\u00f3n infantil, el glitter bar, etc. En resumen. Lo recomiendo? S\u00ed. El balance final es positivo. Pero \u00e1nimo con la organizaci\u00f3n! Y dejad todo s\u00faper atado y mascado para que ese d\u00eda solo tenga que rodar :)","author":{"@type":"Person","name":"Mar B."},"reviewRating":{"@type":"Rating","ratingValue":"4.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2023-07-03","description":"Estamos muy contentos de haberos elegido, fue una boda tan bonita... estuvieron s\u00faper atentos, todo sali\u00f3 perfecto, \u00c1gata, Nico e Isa, un 10, much\u00edsimas gracias.","author":{"@type":"Person","name":"Yolanda"},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2022-05-09","description":"Totalmente recomendado. Lo volver\u00eda a elegir. Un lugar con encanto. Los due\u00f1os estuvieron atentos en todo momento.","author":{"@type":"Person","name":"Lore S."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2020-10-10","description":"Cualquier palabra se queda corta para describir la boda que hemos vivido gracias al gran trabajo, pasi\u00f3n y dedicaci\u00f3n que ha puesto este gran equipo de profesionales. Nico, Bernardo y Marta, gracias por cuidar cada detalle, por tener tanto gusto en la decoraci\u00f3n, por tener un equipo de cocina de cinco estrellas, por el servicio de personal tan atento y amable, y por hacer de este d\u00eda, el mejor d\u00eda de nuestras vidas. Ya estamos deseando tener cualquier otro tipo de evento para volver a estar con vosotros. Os queremos. Tatiana&Francis","author":{"@type":"Person","name":"Tatiana"},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2020-09-13","description":"Bernardo, Nico y Marta, excelentes. Un gran trabajo de todo el equipo. Ha sido la boda que siempre hab\u00edamos so\u00f1ado. El lugar y la decoraci\u00f3n inmejorables. \u00a1Gracias por todo!","author":{"@type":"Person","name":"Ana H."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2020-02-12","description":"Sitio precioso, muy bien decorado. Trato exquisito. Nico, Bernardo y Marta, geniales.","author":{"@type":"Person","name":"Pablo S."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-01-13","description":"Recomendar\u00edamos mil veces alquer\u00eda de Vilches. El trato de Nico fue fant\u00e1stico en todo momento. Escogimos un men\u00fa de arroces y, tanto el men\u00fa como el c\u00f3ctel estaba espectacular, nuestros invitados quedaron encantados con la comida y la fiesta. Hicieron que el d\u00eda de nuestra boda fuera inmejorable!","author":{"@type":"Person","name":"Alba"},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2023-09-15","description":"Equipo de cocina y camareros de 10, muy profesionales, r\u00e1pidos, con buen humor y eficientes. A destacar \u00c1gatha que fue imprescindible en su labor como WP, hizo realidad lo que ten\u00edamos en mente para la boda y qued\u00f3 perfecto. El recinto en cuanto a espacio se acoplaba perfectamente al n\u00famero de invitados,a comida previa (fideu\u00e1, arroz al se\u00f1oret y c\u00f3ctel) impecables y buen\u00edsimo, todo en su punto. Resopon coqueto y sabroso. En definitiva, disfrutamos de nuestro gran d\u00eda. Gracias Nico por un gran d\u00eda","author":{"@type":"Person","name":"Marta G."},"reviewRating":{"@type":"Rating","ratingValue":"4.6","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2023-07-01","description":"Todo fue m\u00e1s que perfecto, tal y como lo hab\u00edamos so\u00f1ado, o incluso mejor. Mil gracias a Nico y a todos los profesionales que hicieron posible que nuestro d\u00eda saliese perfecto. Nuestros invitados quedaron encantados con todo, lo pasamos genial. Sin duda, os recomiendo para una boda de cuento. Muchas gracias.","author":{"@type":"Person","name":"Silvia"},"reviewRating":{"@type":"Rating","ratingValue":"4.8","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2020-02-13","description":"Todo sali\u00f3 muy bien gracias al trato y atenci\u00f3n de todo el equipo de la Alquer\u00eda de Vilches. Un gran placer celebrar all\u00ed nuestra boda. Todos los invitados disfrutaron tanto del lugar, como de su comida junto a nosotros. La estancia en sus habitaciones fue tambi\u00e9n excelente. Gracias por todo. Un 20 de septiembre del 2019 inolvidable.","author":{"@type":"Person","name":"Ver\u00f3nica E."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2020-02-12","description":"Son grandes profesionales y con mucho gusto. Quedamos encantados. Nos atendieron en todo momento con mucho cari\u00f1o.","author":{"@type":"Person","name":"Rebeca P."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2019-12-29","description":"Hemos celebrado nuestro enlace en la Alquer\u00eda de Vilches, y todo m\u00e1s o menos ha salido como esper\u00e1bamos. Muy profesionales, y gracias a Marta que ha estado con todo detalle hasta el final. Son muy flexibles y es un gran punto a favor. Al tener cocina propia la comida estaba buen\u00edsima, otro gran punto a favor. Los invitados han quedado encantados con las habitaciones. Muchas gracias por todo.","author":{"@type":"Person","name":"Sarai M."},"reviewRating":{"@type":"Rating","ratingValue":"4.2","bestRating":5,"worstRating":0}}]}]            </script>
