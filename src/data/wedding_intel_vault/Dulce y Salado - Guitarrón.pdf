                </div>
                <button onClick={() => onAction('SIMULATE', 'Pricing +15%')} className="px-3 py-1 bg-blue-500 text-black text-[9px] font-black uppercase rounded hover:bg-white transition-colors">
                    Simular
                </button>
            </div>
        </div>

        {/* 3. CLOSED LOOP */}
