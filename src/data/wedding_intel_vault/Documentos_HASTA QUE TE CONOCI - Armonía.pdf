0\/jpg\/rrss-0248_1_1946-169703224118741.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0253_1_1946-169703226414672.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0254_1_1946-169703226465911.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0260_1_1946-169703229169449.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0151_1_1946-169703162168797.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0158_1_1946-169703162254991.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0159_1_1946-169703162296922.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0177_1_1946-169703167629331.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0162_1_1946-169703162224099.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0163_1_1946-169703162270412.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0170_1_1946-169703164788641.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0160_1_1946-169703162289634.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/17.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0143_1_1946-169703155260700.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0167_1_1946-169703164669126.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0178_1_1946-169703169014100.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0180_1_1946-169703170373042.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/1946\/3_2\/960\/jpg\/rrss-0182_1_1946-169703172590761.webp","width":960,"height":640}],"review":[{"@type":"Review","datePublished":"2024-12-03","description":"Nos encant\u00f3 el lugar, estuvo precioso, la atenci\u00f3n de primera, detalles muy bonitos, felices con nuestra elecci\u00f3n, estuvimos encantados y lo recomendamos","author":{"@type":"Person","name":"Giovanna P."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-12-01","description":"Gracias a todo el equipo FuenteArcos, Jos\u00e9 Loeches, Angel y Javier por hacerlo realidad.","author":{"@type":"Person","name":"Cristina G."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-10-23","description":"La profesionalidad que tienen es inmejorable. Nuestra boda sali\u00f3 perfecta. Todo el mundo nos dijo que la comida y el trato fueron de 10. Repetir\u00edamos sin dudarlo con ellos. Nuestro jefe de sala Jos\u00e9 siempre atento a nosotros y se acordaba absolutamente de todas las propuestas que hicimos. Gracias!","author":{"@type":"Person","name":"Coral H."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-10-20","description":"La comida estaba buen\u00edsima. Todo el personal muy profesional y gracias a ellos todo sali\u00f3 perfecto.","author":{"@type":"Person","name":"Vanesa A."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-09-23","description":"La comid exquisita, pero el trato del personal insuperable. La verdad es que hicimos una boda de diez y fue gracias a ellos. Much\u00edsimas gracias por todo!!","author":{"@type":"Person","name":"Beatriz T."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-09-11","description":"Nuestra boda no pudo ser mejor gracias al trabajo de todos los que lo hicieron posible. Calidad precio inmejorable, la cantidad y calidad de la comida genial, el trato y la atenci\u00f3n maravillosos. Nuestra m\u00e1s sincera enhorabuena a todo el personal y a Jairo por ser tan atento en nuestro gran d\u00eda. Un 10.","author":{"@type":"Person","name":"Lidia S."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-08-06","description":"Buenos d\u00edas Somos Mer y Fran, nos casamos el s\u00e1bado, 3 de agosto, en el sal\u00f3n Trebol. En primer lugar, quiero dar las gracias a todo el equipo de profesionales que trabajan all\u00ed, en especial a Jos\u00e9, por su cari\u00f1o y su implicaci\u00f3n desde el primer momento, en todo y cada uno de los momentos que vivimos all\u00ed, por estar dispuesto a todo y por el cari\u00f1o que demostraba en cada de sus gestos \u2764\ufe0f. Tambi\u00e9n, agradecer a Luismi y a su compa\u00f1ero, \u00c1ngel, porque sin ellos no falt\u00f3 la m\u00fasica en ning\u00fan momento, por dar ese toque de alegr\u00eda imprescindible en todo momento y por hacerlo todo con tanta naturalidad. Por otro lado, a Iris, nuestra Wedding Planner, porque sin ella esto no habr\u00eda sido posible, por dejarlo todo tan bonito y tan predispuesta a todo, solucionando cualquier cosita que pudiese surgir \ud83e\udd70 Por otro lado, a todos l@s camer@s que estuvieron all\u00ed, por servirnos y estar detr\u00e1s nuestra todo el rato, para que no nos faltara nada, por preocuparse por todos y cada uno de los invitad@s. No tenemos palabras para describir lo que vivimos el s\u00e1bado, fue el mejor d\u00eda de nuestras vidas, y tenemos unos recuerdos tan imborrables que dudo que nunca los borremos de nuestro coraz\u00f3n \u2764\ufe0f De verdad..Millones de gracias por esa empat\u00eda y cari\u00f1o que demostrasteis cada uno en todo momento, nunca lo olvidaremos. Si tuviera que volver a elegir otro sitio, os volver\u00eda a elegir, tenerlo claro Mer & Fran 03.08.24","author":{"@type":"Person","name":"Mer"},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-07-07","description":"No hay palabras por el trato recibido. Nos cuidaron y mimaron. Nuestros invitados en todo momento estuvieron atendidos. La comida de 10! Jos\u00e9 el metre es un profesional. Gracias por hacer de nuestra boda un d\u00eda inolvidable.","author":{"@type":"Person","name":"Daniela"},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-07-05","description":"Fue el segundo sitio que fuimos a ver y seg\u00fan salimos para coger el coche volvimos atr\u00e1s para reservar nuestro d\u00eda! Desde el mes de antes de mi celebraci\u00f3n llame mil veces, siempre muy atentos, en la reuni\u00f3n de protocolo me ayudaron much\u00edsimo con dudas que ten\u00eda sobre mesas y momento detalles en el banquete, y el d\u00eda de la celebraci\u00f3n sin palabras! El c\u00f3ctel fue incre\u00edble, mi marido y yo ten\u00edamos a una persona para traernos comida y bebida, el metre (Jairo) siempre pendiente de que no nos faltase nada y todo saliese tal y como me hab\u00eda imaginado, lo hicieron todo tan f\u00e1cil que pude disfrutar de mi d\u00eda al 200%! Los invitados encantados con todo el servicio de camareros! Sin duda lo recomiendo, si quieres una boda perfecta y redonda no dudes en celebrarla aqu\u00ed! Gracias por hacer que nuestro dia se haya convertido en inolvidable!","author":{"@type":"Person","name":"Eleny R."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2023-12-09","description":"Estamos encantados, no cambiar\u00edamos por nada del mundo el lugar de celebraci\u00f3n de nuestra boda. Cada rinc\u00f3n de Fuentearcos es precioso, la comida riqu\u00edsima pero lo mejor que tienen es sin duda su personal, \u00c1ngel y Jos\u00e9 son encantadores, los mejores haciendo su trabajo. Siempre pendientes de todo, atentos a casa detalle y a casa gesto para conseguir que todo est\u00e9 perfecto para ese d\u00eda. Yo soy cel\u00edaca y \u00c1ngel estuvo ah\u00ed para m\u00ed adaptando cada cosa del men\u00fa para que yo estuviese contenta, siempre amable, con una sonrisa y muy cercano. Jos\u00e9 es un crack, no s\u00e9 ni c\u00f3mo pudo estar a tant\u00edsimas cosas el d\u00eda de la boda, mil detalles, regalos, momentos...estuvo pendiente de todo lo que le pedimos y de mil cosas m\u00e1s que ni pensamos que pasar\u00edan. Adem\u00e1s fue verle y se me fueron los nervios, siempre alegre, dispuesto a liarse en lo que sea para que todo salga perfecto, le vi y supe que todo saldr\u00eda bien. Mil gracias de verdad a los dos porque hicisteis que ese d\u00eda fuese perfecto!!","author":{"@type":"Person","name":"Estefan\u00eda M."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2023-11-16","description":"Celebramos nuestra boda en Fuentearcos y fue una elecci\u00f3n m\u00e1s que acertada! El sitio es precioso no, lo siguiente!!! Una maravilla de jardines y mobiliario. La comida estuvo impresionante, de hecho tambi\u00e9n es un restaurante y fuimos varias veces a comer all\u00ed - inmejorable. El c\u00f3ctel tiene una variedad impresionante, muy completo e innovador y de men\u00fa elegimos el gazpacho de cereza con helado de mascarpone que es realmente espectacular, el canel\u00f3n de dorada rellena de marisco y solomillo con foie, y el postre - esta delicia que adjunto en fotos!!! He de destacar el trato estupendo de todo el equipo y m\u00e1s en concreto de Cesar y de Jose que se encarg\u00f3 de nuestro d\u00eda. Nos hizo sentir de maravilla, tranquilizar cuando hizo falta, con mucha calma y comprensi\u00f3n, aconsejando y pendiente de nosotros todo el