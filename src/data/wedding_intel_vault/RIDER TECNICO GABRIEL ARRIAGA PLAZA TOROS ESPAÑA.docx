						<script src="https://herzkarten.io/rsc/js/client.js" type="text/javascript"></script>
						<script>
						window.addEventListener('DOMContentLoaded', function() {
							(function(_doc) {
								window.ppclient = new PitchPrintClient({
																			uploadUrl: './uploads/',
											clientVersion: 2,
											userId: 'guest',
											langCode: 'es',
											enableUpload: false,
											designId: '2ce1a37b864c07404f9581910002df8d',
											previews: '',
											mode: 'new',
											createButtons: true,
											projectId: '',
											apiKey: '6ec4a0e70cf6ccdb113f2f659a6ebdff',
											cValues: '',
											client: 'oc',
											product: {
												id: '1301', 
												name: 'Natural Monogram - Invitaci√≥n de boda - Tarjeta plegable (vertical)'
											},
											frameDomain: 'https://herzkarten.io',
											apiBase: 'https://api.herzkarten.io/client/',
											domainBase: 'https://herzkarten.io/',
											domainDirect: 'https://s3-eu-central-1.amazonaws.com/herzkarten.io/',
											pdfBase: 'https://pdf.herzkarten.io',
																						ppOptionId: '2630'
															});
							if(sessionStorage.getItem("openDesigner") == "true"){
								sessionStorage.setItem("openDesigner", false);
								ppclient.fire('show-app');
							}
							window.ppclient.on('lang-loaded', function(es){					
								setTimeout(function() {
									if(!ppclient._act.frameValidated){
										$('#pp_customize_design_btn').before('<div style="border: 1px solid #f4e99d;margin-bottom: 0px;" id="incog_warning" class="alert alert-warning">No se puede iniciar el editor, por favor, salga del modo inc√≥gnito o desactive el bloqueador de anuncios.</div>');
									}
								}, 2000);
							});
							window.ppclient.on('project-saved', function(es){								
								console.log($.post( "index.php?route=product/product/saveProject", { project: es.data.projectId, design_data: es.data.source.pages, product_id: 1301 } ));
							});
							window.ppclient.on('lang-loaded', function(es){					
								$('#pp_main_btn_sec > input[type="hidden"]').val('');
							});

						})(document);
window.ppclient.on('editor-shown', function(){

					if('0' == '1'){
						window.ppclient.fire('show-help-box');
						$.ajax({
							url: "index.php?route=account/account/visit"					
						});
					}
					});
					
					var closing_type = "cancled";
					window.ppclient.on('after-close-app', function(_e){	
						$('.product-right').removeClass("designer-open");
						$('iframe[src="https://herzkarten.io/index.html"]').removeClass("designer-open");
								
						if(closing_type == "success")
							$('#button-cart').click();
						if(closing_type == "save"){
							setTimeout(function () {
								window.location.href = '/account';						
							}, 1500)
						}
					});

					$('.swatch-color').click(function(){
						window.ppclient.fire('setSwatch', $(this).data('id'));
					});
					
					window.ppclient.on('editor-shown', function(){
						$('.product-right').addClass("designer-open");
						$('iframe[src="https://herzkarten.io/index.html"]').addClass("designer-open");
					});

					window.addEventListener('message', function(e) {
						var response = e.data;
						if(Array.isArray(e.data)){
							if(response[0] == "hkDesignerEvent"){
								closing_type = response[1];
								console.log(response[1]);
								switch(response[1]){
									case 'save':
										let resp = JSON.parse(response[2]);
										$.post( "index.php?route=product/product/saveProject", { project: resp.project, design_data: resp.design_data, product_id: resp.product_id  } );
										break;
									case 'closed':
										closing_type = "cancled";
									case 'preview':
										$('.product-right').removeClass("designer-open");
										$('iframe[src="https://herzkarten.io/index.html"]').removeClass("designer-open");
										break;
									case 'cancled':
										$('.product-right').addClass("designer-open");
										$('iframe[src="https://herzkarten.io/index.html"]').addClass("designer-open");
										break;
									case 'folie-gold': 	
										$('img[data-option-id="65"]').siblings('input').click();
										_setCl();
										break;
									case 'folie-silber': 
										$('img[data-option-id="66"]').siblings('input').click();
										_setCl();
										break;	
									case 'folie-rose':
									 	$('img[data-option-id="67"]').siblings('input').click();
										 _setCl();
										 break; 
									case 'show-warenkorb':
										if($('.product-right.designer-open').width() > 0){
											$(".product-right.designer-open").animate({width:'0%'},350);
										} 
										else{
											$(".product-right.designer-open").animate({width:'60%'},350); 
										}		
								}
							}
						}
					}, false);
					
						});
						</script>
			            		<script src="https://herzkarten.io/rsc/js/mods.js" type="text/javascript"></script>
					
				
