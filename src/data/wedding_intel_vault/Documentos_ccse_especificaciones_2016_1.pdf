<li class="seoFaqs__itemList">
<i class="svgIcon app-svg-async svgIcon__checkLight "   data-svg="https://cdn1.bodas.net/assets/svg/optimized/_common/checkLight.svg" data-svg-lazyload="1"></i>                                            A las afueras de la ciudad                                        </li>
