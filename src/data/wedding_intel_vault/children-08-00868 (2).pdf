    <div class="module-body">
                                      <div class="panel-group" id="blocks-6769200b9e73b-collapse" itemscope itemtype="https://schema.org/FAQPage">
                  <div class="module-item module-item-1 panel" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <div class="panel-heading">
              <h4 class="panel-title">
                <a href="#blocks-6769200b9e73b-collapse-1" class="accordion-toggle collapsed" data-toggle="collapse" data-parent="#blocks-6769200b9e73b-collapse" aria-expanded="false">
                  <span itemprop="name">¿Qué formato debe tener mi invitación de boda?</span>
                  <i class="fa fa-caret-down"></i>
