  }
  .desktop header{
    width: 100%;
    top: 0;
    position: fixed;
  }
  .desktop.popup-open header.header-compact {
    padding-right: 17px;
  }
  .desktop.popup-open.webkit header.header-compact {
    padding-right: 10px;
  }
  

