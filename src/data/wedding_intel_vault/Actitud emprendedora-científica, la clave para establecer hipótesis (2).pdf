 01-.552.834l-3.29-2.175a.5.5 0 11.552-.834l3.29 2.175zm-14.37.834a.5.5 0 01-.552-.834l3.29-2.175a.5.5 0 11.551.834l-3.29 2.175zm7.185-1.859a.5.5 0 11-.562-.827l7.206-4.893a.5.5 0 01.562.827l-7.206 4.893z" fill-rule="nonzero"> </path> </svg> </i> {{ no_span }} </a> </div> </li> <li class="layoutNavMenuAuthLogged__avatar app-header-authenticator-toggle"> <div class="layoutNavMenuAuthLogged__avatarContainer"> <a href="https://www.bodas.net/tools/Main"> {{ user_picture }} <span class="layoutNavMenuAuthLogged__avatarCounter"> {{ no_mobile }} </span> </a> </div> </li> </ul>';
								let login_html = '<a href="https://www.bodas.net/users-login.php?r=https%3A%2F%2Finvitaciones.bodas.net" rel="nofollow" class="layoutHeader__authNoLoggedAreaMobile"> <i class="svgIcon svgIcon__user "> <svg viewBox="0 0 47 53"> <path d="M31.722 29.786C40.49 32.99 46.78 42.236 46.78 51.962v1H.846v-1c0-9.615 6.156-18.77 14.774-22.069-2.971-1.686-5.407-4.324-6.774-7.691-3.236-7.981.75-17.009 8.891-20.172 8.13-3.154 17.343.736 20.575 8.698 2.915 7.181-.03 15.22-6.59 19.058zm-12.16 1.698l-2.469.006c-7.922 2.633-13.8 10.765-14.222 19.472h41.885c-.423-8.744-6.343-16.9-14.309-19.501l-2.786.006a16.09 16.09 0 01-8.099.017zm-1.1-27.59c-7.11 2.762-10.576 10.617-7.763 17.556 2.82 6.944 10.88 10.347 17.998 7.582 7.107-2.761 10.575-10.62 7.762-17.551C33.64 4.537 25.579 1.133 18.46 3.895z" fill-rule="nonzero"> </path> </svg> </i> </a> <div class="layoutHeader__authNoLoggedArea app-header-auth-area"> <a class="layoutHeader__vendorAuth" rel="nofollow" href="https://www.bodas.net/emp-Acceso.php"> <i class="svgIcon svgIcon__briefcase layoutHeader__vendorAuthIcon"> <svg viewBox="0 0 48 41"> <path d="M44.3 27.917h.933V13.925c0-1.46-1.199-2.86-3.057-3.625H5.825c-1.859.766-3.058 2.164-3.058 3.625v13.992h14.866V24.39a1 1 0 011-1h10.734a1 1 0 011 1v3.527H44.3zm-2.133 2h-11.8v.51a1 1 0 01-1 1H18.633a1 1 0 01-1-1v-.51h-11.8v8.564h36.334v-8.564zM14.567 8.3v-.51c0-3.797 2.855-7.035 6.533-7.035h5.8c3.68 0 6.533 3.236 6.533 7.036V8.3h8.935a1 1 0 01.358.066c2.655 1.02 4.507 3.115 4.507 5.559v14.992a1 1 0 01-1 1h-2.066v9.564a1 1 0 01-1 1H4.833a1 1 0 01-1-1v-9.564H1.767a1 1 0 01-1-1V13.925c0-2.445 1.852-4.54 4.509-5.559a1 1 0 01.358-.066h8.933zm13.8 21.126V25.39h-8.734v4.036h8.734zm3.066-21.635c0-2.747-2.018-5.036-4.533-5.036h-5.8c-2.513 0-4.533 2.29-4.533 5.036V8.3h14.866v-.51z" fill-rule="nonzero"> </path> </svg> </i> Área Empresas </a> <ul class="layoutNavMenuAuth"> <li class="layoutNavMenuAuth__item"> <a href="https://www.bodas.net/users-login.php" rel="nofollow" class="layoutNavMenuAuth__anchor"> Accede </a> </li> <li class="layoutNavMenuAuth__item"> <a href="https://www.bodas.net/users-signup.php" rel="nofollow" class="layoutNavMenuAuth__anchor"> Regístrate </a> </li> </ul> </div>';
								
								if(userData.num_unread_msgs != 0){
