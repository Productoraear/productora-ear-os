									user_html = user_html.replace('{{ no_mobile }}','<span class="layoutNavMenuAuthLoggedInbox__number"> ' + userData.num_unread_msgs + ' </span>');
								}else{
									user_html = user_html.replace('{{ no_span }}','');
									user_html = user_html.replace('{{ no_mobile }}','');

								}
								if(typeof userData.avatar != "undefined" && userData.avatar.img != ""){
									user_html = user_html.replace('{{ user_picture }}','<picture class="avatar__img"> <img src="' + userData.avatar.img + '" sizes="(min-width: 480px) 80px, 56px" alt="' + userData.username + '" width="80" height="80"> </picture>');
