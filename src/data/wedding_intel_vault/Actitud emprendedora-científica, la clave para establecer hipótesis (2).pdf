			<script>
				var userData = "";
			
					if((document.cookie.includes(" USER_TIPO=") && document.cookie.includes(" USER_ID=") && document.cookie.includes(" UC=")) || (document.cookie.includes(" tkww-access-token=") && document.cookie.includes(" tkww-refresh-token=")) ){
						$.ajax({
							url: "https://www.bodas.net/users/getHeaderData",

							xhrFields: {
								withCredentials: true
							},
							success: function(response){
								userData = response;
							
