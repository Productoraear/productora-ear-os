/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/IMG_5323.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/JPG\/P9220354.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/la-foto-4.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/la-foto-5.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/la-foto-12.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-1_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-2_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-3_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-4_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-7_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-8_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-9_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-10_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-11_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-12_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-13_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-14_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-15_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-16_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-17_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-19_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-20_1_5318.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-1_1_5318_v1.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-2_1_5318_v1.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-5_1_5318_v1.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-7_1_5318_v1.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-8_1_5318_v1.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/5318\/3_2\/960\/jpg\/aspaldiko-9_1_5318_v1.webp","width":960,"height":640}],"review":[{"@type":"Review","datePublished":"2024-02-29","description":"Celebrar nuestra boda en Aspaldiko fue justo lo que busc\u00e1bamos. Comida tradicional de la zona de gran calidad, espacio representativo de nuestra historia y la atenci\u00f3n fue genial.","author":{"@type":"Person","name":"Joane B."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2022-06-08","description":"Elegir el restaurante Aspaldiko para nuestra boda fue todo un acierto. Javier ha estado pendiente de todo y la boda no podr\u00eda haber salido mejor. Los invitados encantados con la comida y con el servicio en general.","author":{"@type":"Person","name":"Tamara"},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2022-01-10","description":"Somos de esos muchos novios que tuvieron que retrasar su boda por el Covid. Javier en todo momento fue muy comprensivo y nos ayud\u00f3 con las dudas y miedos. El d\u00eda fue incre\u00edble, estuvieron muy atentos y todo fue perfecto.","author":{"@type":"Person","name":"Nahia V."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2020-11-09","description":"Debido al Covid, no pudo ser la boda en Aspaldiko, solo puedo hablar del trato recibido y la atenci\u00f3n previa y es impecable.","author":{"@type":"Person","name":"Ana R."},"reviewRating":{"@type":"Rating","ratingValue":"4.8","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2020-09-28","description":"La mejor comida, el mejor entorno, el mejor personal. Nos han puesto todas las facilidades en esta situaci\u00f3n tan complicada y han hecho que nuestro d\u00eda sea perfecto e inolvidable tanto para nosotros como para nuestros invitados. Eskerrik asko!","author":{"@type":"Person","name":"Maria M."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2020-09-01","description":"\u00a1Sin palabras! Desde principio a fin ha sido una maravilla el trato que hemos recibido por parte del restaurante. Y el d\u00eda de la boda, otra maravilla. La comida riqu\u00edsima. Los invitados encantados. Y el sitio, \u00a1espectacular! Es precioso y muy acogedor. Muy, muy recomendable. Eskerrik asko por todo, Javi!","author":{"@type":"Person","name":"Sandra"},"reviewRating":{"@type":"Rating","ratingValue":"4.8","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2020-08-25","description":"Tuvimos un inconveniente con el restaurante en el que \u00edbamos a celebrar nuestra boda y, a tan solo 2 d\u00edas del gran d\u00eda, el restaurante Aspaldiko se puso a nuestro servicio, estamos muy agradecidos, se han portado de maravilla. Todo de 10, comida, atenci\u00f3n, entorno... \u00a1Mil gracias por todo!","author":{"@type":"Person","name":"Sara L."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2019-10-28","description":"No pod\u00edamos haber elegido mejor restaurante para celebrar nuestra boda. Todo perfecto, el lugar, el trato (eskerrik asko, Yoli, por todo), el men\u00fa... \u00a1Imposible describir lo vivido!","author":{"@type":"Person","name":"Esti C."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2019-02-17","description":"No pudimos hacer mejor elecci\u00f3n cuando buscamos lugar para celebrar nuestro d\u00eda. Desde el primer momento que pisamos el Aspaldiko supimos que ser\u00eda nuestro lugar. Tiene una magia especial que te atrapa cuando entras en \u00e9l y ya cuando conoces a su equipo, te enamoras de tal manera que sabes que no puede haber un lugar mejor para celebrar el d\u00eda de tu boda. Nos ayudaron en todo lo que les pedimos, no pusieron pegas a nuestras peticiones, nos guiaron perfectamente en la elecci\u00f3n del men\u00fa... El d\u00eda de la boda hicimos la ceremonia all\u00ed y sali\u00f3 todo a la perfecci\u00f3n y la comida espectacular. Desde el primer plato del c\u00f3ctel hasta el ultimo que se sirvi\u00f3 en la mesa fue todo perfecto, todos los invitados nos felicitaron por la comida y la felicitaci\u00f3n sin duda es para ellos porque son un equipo de 10. No tenemos palabras para agradecer a Javier, Yolanda y todo su equipo el trato recibido y lo perfecto que fue todo el d\u00eda de nuestra boda y durante los meses de preparaci\u00f3n. \u00a1Sin duda, si nos volvi\u00e9ramos a casar, volver\u00edamos a elegir el Aspaldiko siempre! \u00a1Gracias infinitas! \u00a1Nos veremos los 29 de septiembre!","author":{"@type":"Person","name":"Udane y \u00c1lvaro"},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2018-10-24","description":"Todo sali\u00f3 perfecto, muchas gracias a Javi por todo, siempre dispuesto y con soluciones para todo, \u00a1sin duda la mejor elecci\u00f3n que pod\u00edamos hacer para nuestro d\u00eda! Gracias y gracias.","author":{"@type":"Person","name":"Naiara C."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2015-09-29","description":"El sitio es precioso, y la comida excelente. Todos mis invitados quedaron fascinados. Volver\u00e9 a comer all\u00ed, sin duda, para celebrar mi aniversario de boda. Un sobresaliente para todo el equipo de Aspaldiko.","author":{"@type":"Person","name":"Lorena S."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2014-11-26","description":"Fue un d\u00eda inolvidable y lo mejor de todo que esa opini\u00f3n es compartida por todos los invitados a nuestra boda. Nos han pedido compartir con nosotros cada aniversario en el mismo sitio. \u00a1Creo que con eso lo digo todo! \u00a1100% recomendable!","author":{"@type":"Person","name":"Itziar V."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2014-10-01","description":"La atenci\u00f3n durante todo el d\u00eda de mi boda fue simplemente de 10. Tanto el encargado durante la ceremonia, los camareros durante el coctail, la comida, en la barra libre. Estuve preguntando despu\u00e9s a mis invitados y algunos que tuvieron alguna petici\u00f3n 'especial' (leche para biberones, caf\u00e9 cuando ya estaban con los licores, ayudar a subir los detalles) me comentaron que todo era amabilidad y predisposici\u00f3n. La comida espectacular y puedo asegurar que nadie se qued\u00f3 con hambre. Mi ya marido y yo entramos hasta la cocina para felicitar al equipo y todo. No contrat\u00e9 recena pero tampoco me pusieron ninguna pega en poner por nuestra cuenta un candy bar y otro rinc\u00f3n de saladitos (es que yo cuando bebo soy m\u00e1s de salado que de dulce). Tuve una decoradora que fue a dejarlo todo a mi gusto y luego se encargaron los del restaurante de recogerlo todo y dej\u00e1rmelo en un rinc\u00f3n para llev\u00e1rmelo cuando fuera a pagar. Esa es otra, todo facilidades para pagar. Dimos la se\u00f1al cuando reservamos y si nos casamos el s\u00e1bado hasta el lunes no fuimos a pagar. Nada de irte a un apartado a contar dinero para pagarlo ese mismo d\u00eda, que me parece super cutre. Yo me cas\u00e9 de ma\u00f1ana y hubo otra boda de tarde, pues s\u00f3lo deciros que no coincidimos en ning\u00fan momento con nadie de la otra boda. Si me volviera a casar sin duda lo volver\u00eda a hacer aqu\u00ed, no tengo ning\u00fan pero.","author":{"@type":"Person","name":"Roxanna M."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2013-10-01","description":"Nos casamos el 27 de Julio en el aspaldiko y todo sali\u00f3 fenomenal. Javi est\u00e1 pendiente de todo, as\u00ed da gusto. La comida excelente, todo el mundo nos felicit\u00f3. Sin duda me volver\u00eda a casar all\u00ed. Muchas gracias por ayudarnos a que nuestra boda fuese uno de los mejores d\u00edas de nuestras vidas. Un abrazo a Javi, Yolanda y todo el equipo del aspaldiko.","author":{"@type":"Person","name":"Anne"},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-11-26","description":"Celebramos nuestra boda el d\u00eda 23 y la verdad que todo espectacular. La comida de 10 el servicio igual. La gente encantada , todo estaba exquisito. Y el lugar m\u00e1gico. Muchas gracias por todo.","author":{"@type":"Person","name":"Jessica R."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}}]}]            </script>
