<section class="storefrontOwners app-section-highlighter-item">
<h2 id="owners" class="storefrontOwners__title" tabindex="-1">Equipo</h2>
<div class="storefrontOwners__list">
<div class="storefrontOwners__item app-owners-tile ">
<div class="storefrontOwners__avatar">
<picture class="avatar__img"     data-image-name="imageFileName_uo_2798_8419.jpeg?r=1674720892">
<source
type="image/webp"
data-srcset="https://cdn0.bodas.net/vendor/2798/1_1/80/jpg/uo_2798_8419.webp?r=1674720892 80w,
https://cdn0.bodas.net/vendor/2798/1_1/160/jpg/uo_2798_8419.webp?r=1674720892 160w" sizes="(min-width: 480px) 80px, 56px">
<img
data-srcset="https://cdn0.bodas.net/vendor/2798/1_1/80/jpg/uo_2798_8419.jpeg?r=1674720892 80w,
https://cdn0.bodas.net/vendor/2798/1_1/160/jpg/uo_2798_8419.jpeg?r=1674720892 160w"
