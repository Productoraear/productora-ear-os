body.dispatchEvent(event);
}
if (typeof window.__tcfapi !== "undefined") {
event.initEvent('oneTrustLoaded', true, false);
body.dispatchEvent(event);
clearInterval(consentSetInterval);
window.__tcfapi('addEventListener', 2, callbackIAB);
}
});
}
