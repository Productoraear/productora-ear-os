<script>
   $('.dropdown.stationary.stationary-mobile').click(function(){
      if($(".stationary-mobile > .dropdown-menu.j-dropdown").css('opacity') == 1){
        $(".stationary-mobile > .dropdown-menu.j-dropdown").css({opacity: "0", visibility: "hidden"});

      }else{
        $(".stationary-mobile > .dropdown-menu.j-dropdown").css({opacity: "1", visibility: "visible"});
      }
   });
  
 
