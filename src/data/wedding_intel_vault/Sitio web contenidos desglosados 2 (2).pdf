import React, { useState, useRef, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
    Send,
    Bot,
    User,
    Zap,
    Loader2,
    ShieldCheck,
    Terminal,
    Sparkles,
    BrainCircuit
} from 'lucide-react';
import { earAiTwinService } from '../../services/earAiTwinService';
import type { AIRole, AIResponse } from '../../services/earAiTwinService';

interface Message {
    id: string;
    role: 'ai' | 'user';
    content: string;
    timestamp: Date;
    actions?: string[];
    metadata?: AIResponse['metadata'];
}

interface EARAiConsoleProps {
    userRole: AIRole;
}

export const EARAiConsole: React.FC<EARAiConsoleProps> = ({ userRole }) => {
    const [messages, setMessages] = useState<Message[]>([
        {
            id: 'init',
            role: 'ai',
            content: `Sistema EAR AI Twin inicializado. Perfil detectado: **${userRole.toUpperCase()}**. ¿En qué puedo asistirte hoy siguiendo los protocolos de IA Studio?`,
            timestamp: new Date()
        }
    ]);
    const [inputValue, setInputValue] = useState('');
    const [isTyping, setIsTyping] = useState(false);
    const scrollRef = useRef<HTMLDivElement>(null);

    useEffect(() => {
        if (scrollRef.current) {
            scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
        }
    }, [messages, isTyping]);

    const handleSend = async () => {
        if (!inputValue.trim() || isTyping) return;

        const userMsg: Message = {
            id: Date.now().toString(),
            role: 'user',
            content: inputValue,
            timestamp: new Date()
        };

        setMessages(prev => [...prev, userMsg]);
        setInputValue('');
        setIsTyping(true);

        try {
            const response = await earAiTwinService.processQuery({
                query: inputValue,
                role: userRole
            });

            const aiMsg: Message = {
                id: (Date.now() + 1).toString(),
                role: 'ai',
                content: response.text,
                actions: response.actions,
                timestamp: new Date(),
                metadata: response.metadata
            };

            setMessages(prev => [...prev, aiMsg]);
        } catch (error) {
            const errorMsg: Message = {
                id: 'err',
                role: 'ai',
                content: "Error en el enlace neural. Protocolo de contingencia activado. Por favor, reintenta la comunicación.",
                timestamp: new Date()
            };
            setMessages(prev => [...prev, errorMsg]);
        } finally {
            setIsTyping(false);
        }
    };

    return (
        <div className="flex flex-col h-[600px] w-full bg-black/40 border border-white/10 rounded-[2.5rem] overflow-hidden backdrop-blur-3xl shadow-2xl relative">

            {/* Header / Info Bar */}
            <div className="px-8 py-6 border-b border-white/5 bg-white/5 flex items-center justify-between">
                <div className="flex items-center gap-4">
                    <div className="p-3 bg-ear-gold/20 rounded-2xl border border-ear-gold/30">
                        <BrainCircuit size={20} className="text-ear-gold animate-pulse" />
                    </div>
                    <div>
                        <h3 className="text-sm font-black text-white uppercase tracking-widest italic flex items-center gap-2">
                            ASTRA OS <span className="text-ear-gold">EAR TWIN</span>
                            <span className="text-[8px] bg-ear-gold text-black px-1.5 py-0.5 rounded font-black italic">v10.0</span>
                        </h3>
                        <p className="text-[10px] text-gray-500 font-bold uppercase tracking-widest">
                            {userRole.toUpperCase()} CONTEXT • ANALYZER ACTIVE
                        </p>
                    </div>
                </div>
                <div className="hidden md:flex items-center gap-2 px-3 py-1 bg-green-500/10 border border-green-500/20 rounded-full">
                    <div className="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse" />
                    <span className="text-[9px] font-black text-green-500 uppercase">Enlace Estable</span>
                </div>
            </div>

            {/* Messages Area */}
            <div
                ref={scrollRef}
                className="flex-1 overflow-y-auto p-8 space-y-8 custom-scrollbar"
            >
                <AnimatePresence mode="popLayout">
                    {messages.map((item) => (
                        <motion.div
                            key={item.id}
                            initial={{ opacity: 0, y: 10 }}
                            animate={{ opacity: 1, y: 0 }}
                            className={`flex ${item.role === 'user' ? 'justify-end' : 'justify-start'}`}
                        >
                            <div className={`max-w-[85%] flex gap-4 ${item.role === 'user' ? 'flex-row-reverse' : 'flex-row'}`}>
                                <div className={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 ${item.role === 'ai' ? 'bg-ear-gold text-black shadow-lg shadow-ear-gold/20' : 'bg-white/10 text-white border border-white/10'}`}>
                                    {item.role === 'ai' ? <Bot size={20} /> : <User size={20} />}
                                </div>
                                <div className="space-y-4">
                                    <div className={`p-6 rounded-[1.8rem] text-sm leading-relaxed ${item.role === 'user' ? 'bg-primary text-black font-medium' : 'bg-white/5 text-gray-200 border border-white/5 font-mono'}`}>
                                        {item.metadata?.persona_active && (
                                            <div className="flex items-center gap-2 mb-3 pb-3 border-b border-white/5">
                                                <div className="w-1.5 h-1.5 bg-ear-gold rounded-full animate-pulse" />
                                                <span className="text-[9px] font-black text-ear-gold uppercase tracking-[0.2em]">Asesor Activo: {item.metadata.persona_active}</span>
                                            </div>
                                        )}
                                        <div className="whitespace-pre-wrap">{item.content}</div>
                                    </div>
                                    {item.actions && item.actions.length > 0 && (
                                        <div className="flex flex-wrap gap-2">
                                            {item.actions.map((act, idx) => (
                                                <button
                                                    key={idx}
                                                    onClick={() => setInputValue(act)}
                                                    className="px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-full text-[10px] text-gray-400 font-bold uppercase tracking-wider transition-all"
                                                >
                                                    {act}
                                                </button>
                                            ))}
                                        </div>
                                    )}
                                </div>
                            </div>
                        </motion.div>
                    ))}
                    {isTyping && (
                        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="flex justify-start gap-4">
                            <div className="w-10 h-10 rounded-xl bg-ear-gold/20 text-ear-gold border border-ear-gold/30 flex items-center justify-center animate-pulse">
                                <Bot size={20} />
                            </div>
                            <div className="p-6 bg-white/5 rounded-[1.8rem] border border-white/5 flex items-center gap-2">
                                <Loader2 size={16} className="text-ear-gold animate-spin" />
                                <span className="text-[10px] text-gray-500 font-black uppercase tracking-widest animate-pulse">ASTRA ANALYZER: Procesando Frecuencia...</span>
                            </div>
                        </motion.div>
                    )}
                </AnimatePresence>
            </div>

            {/* Input Area */}
            <div className="p-6 bg-white/5 border-t border-white/5">
                <div className="relative group">
                    <input
                        type="text"
                        value={inputValue}
                        onChange={(e) => setInputValue(e.target.value)}
                        onKeyPress={(e) => e.key === 'Enter' && handleSend()}
                        placeholder="Emite tu consulta táctica..."
                        className="w-full bg-black/60 border border-white/10 rounded-[1.5rem] py-5 px-8 pr-16 text-white focus:outline-none focus:border-ear-gold/50 transition-all font-light placeholder:text-gray-700"
                    />
                    <button
                        onClick={handleSend}
                        className="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-ear-gold text-black rounded-xl flex items-center justify-center hover:bg-white transition-all group-hover:scale-105 active:scale-95 shadow-lg"
                    >
                        <Send size={18} />
                    </button>
                </div>
                <div className="mt-4 flex 