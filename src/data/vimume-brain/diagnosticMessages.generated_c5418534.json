headers: myHeaders,
body,
redirect: "follow",
};
fetch(
`${host}/experiments/${experimentId}/${bucketingId}`,
requestOptions
).then((response) => {
if (response.ok) {
localStorage.setItem(cacheKey, Date.now());
}
});
});
})();
