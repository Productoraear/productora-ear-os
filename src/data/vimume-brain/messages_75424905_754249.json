dn0.bodas.net\/vendor\/90197\/3_2\/960\/jpeg\/whatsapp-image-2023-05-12-at-13-56-22_1_190197-168389285841017.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/90197\/3_2\/960\/jpeg\/whatsapp-image-2023-05-12-at-13-58-50-2_1_190197-168389286670600.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/90197\/3_2\/960\/jpeg\/whatsapp-image-2023-05-12-at-13-58-50_1_190197-168389287710446.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/90197\/3_2\/960\/jpeg\/whatsapp-image-2023-05-12-at-13-58-51_1_190197-168389288757837.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/90197\/3_2\/960\/jpeg\/whatsapp-image-2023-05-22-at-17-16-41_1_190197-168476910177277.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/90197\/3_2\/960\/jpeg\/whatsapp-image-2023-05-22-at-17-17-08_1_190197-168476911671280.webp","width":960,"height":640},{"@type":"ImageObject","url":"https:\/\/cdn0.bodas.net\/vendor\/90197\/3_2\/960\/jpeg\/whatsapp-image-2023-05-22-at-17-17-24-1_1_190197-168476913394784.webp","width":960,"height":640}],"review":[{"@type":"Review","datePublished":"2024-07-06","description":"Sin duda solo podemos darle las gracias a Maria por hacer que el d\u00eda fuera perfecto. Estuvo en todo momento pendiente de ayudarnos con los preparativos de la boda y por su puesto atenta a todos los momentos ese dia. Es una persona detallista, perfeccionista, super trabajadora y siempre con una sonrisa en la cara, dispuesta a brindarte su ayuda y a resolverte todas las dudas que te van surgiendo. Nos aconsejo en todo y se encarg\u00f3 de muchos de los preparativos que nos ayudaron a quitarnos preocupaciones gracias al servicio que ofrece, bien porque estaban incluidos en el menu y otros porque los pod\u00edas contratar con ella. El entorno es precioso y se encarga de decorar todos los rincones, seg\u00fan tus gustos para que quede a\u00fan m\u00e1s bonito. La gente qued\u00f3 encantada con la comida tanto del cocktail, cena, resopon y candy bar que fue abundante y destacar tambi\u00e9n la atenci\u00f3n de los camarer@s que fue perfecta hasta el final Bajo nuestra experiencia, nos volver\u00edamos a casar una y otra vez con ellos y se lo recomendamos a todo el mundo por el entorno, la buena calidad\/precio y sobretodo por el servicio que ofrecen porque se nota que les gusta lo que hacen y se implican totalmente con los novios y eso es muy importante para un dia tan especial. Maria, muchas gracias a ti y a tu equipo por todo, sois geniales!!","author":{"@type":"Person","name":"Miriam H."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-10-23","description":"\u00a1Impresionante! Podr\u00eda decirse que esta mas\u00eda se resume en una sola palabra: 'perfecta'. Un lugar perfecto para que celebres tu boda y hagas realidad tus sue\u00f1os. Desde el principio, la planificaci\u00f3n y ejecuci\u00f3n de este proyecto ha cumplido todas nuestras expectativas y se ha desarrollado exactamente como lo hab\u00edamos imaginado. Todo es llevado a cabo con un nivel de detalle absoluto, una atenci\u00f3n impecable y una organizaci\u00f3n perfecta. El servicio en el sal\u00f3n es impecable; todos los camareros son muy atentos. La calidad de la comida es excelente, 10\/10. Solo podemos expresar elogios hacia la mas\u00eda, pero especialmente hacia Mar\u00eda, quien destaca por su amabilidad, atenci\u00f3n, sinceridad y meticulosidad en todo lo que hace. Se esfuerza al m\u00e1ximo para garantizar que tu d\u00eda sea memorable, ofreciendo consejos y apoyo constante. \u00a1Te agradezco mucho!","author":{"@type":"Person","name":"Lydia Z."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-08-14","description":"Le pongo 5 estrellas porque no le puedo poner m\u00e1s. Mery estuvo pendiente absolutamente de todo y nada fall\u00f3. La comida buen\u00edsima y en cantidad las camareras muy agradables, el sitio precioso.... volver\u00eda a casarme all\u00ed sin dudarlo. Gracias en parte a ellos, ha sido el mejor d\u00eda de mi vida.","author":{"@type":"Person","name":"Paola G."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-07-24","description":"Lees recomiendo este sitio , la organizacion es de 10 . nosotros organizamos todo desde Londres y Maria estuve ahi para ayudarnos con todo ya que fue una boda en la que todos los invitados veniamos de fuera","author":{"@type":"Person","name":"Leonel M."},"reviewRating":{"@type":"Rating","ratingValue":"4.6","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-05-28","description":"Si buscas un lugar \u00fanico en un entorno inigualable donde la naturaleza es lo que prima y va causar sensaci\u00f3n entre los invitados, este es tu sitio. Nuestra boda fue preciosa gracias a que escogimos Mas\u00eda Venta L'Home, gracias a la profesionalidad de todo su equipo y gracias a que la comida estaba excelente. Comida que no tiene nada que ver con ogros banquetes de boda, aqu\u00ed prima la calidad y el buen gusto, creando platos casi de alta cocina. De verdad, que fue el mejor d\u00eda de nuestra vida y solo tenemos palabras de agradecimiento.","author":{"@type":"Person","name":"Charles P."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-05-28","description":"Ha sido una boda preciosa!!! Ha sido maravilloso todo!! Ni en mis mejores sue\u00f1os hubiera imaginado una boda tan preciosa en Venta de L\u2019Home Mar\u00eda y su hermano Sergio dos personas atentas a todo!! Entra\u00f1ables y maravillosas!! Sin duda me casar\u00eda una y mil veces en este maravilloso lugar!!! Gracias por todo Mar\u00eda gracias por cubrir las expectativas mucho m\u00e1s all\u00e1 de lo que hab\u00edamos imaginado!!! Tenemos el coraz\u00f3n lleno de recuerdos con tanto amor gracias a vosotros y al lugar tan maravilloso que hab\u00e9is creado en Venta de L\u2019Home para cumplir la boda so\u00f1ada de las personas!!! Gracias","author":{"@type":"Person","name":"Jennifer M."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-05-28","description":"La verdad es que si tu boda la quieres dejar en manos de grandes profesionales tienes que contar con el equipo de Mas\u00eda Venta L'Home. Adem\u00e1s, est\u00e1 en un entorno inigualable, totalmente natural y de una belleza asombrosa. La comida espectacular, nada que ver con los t\u00edpicos banquetes de boda, aqu\u00ed se cocina de categor\u00eda y casi dir\u00eda que de alta cocina. No dud\u00e9is y trabajad con ellos. Son los mejores.","author":{"@type":"Person","name":"Charles P."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-05-23","description":"La verdad es que ha sido todo un \u00e9xito celebrar nuestra boda aqu\u00ed. La naturaleza que rodea la masia es el mejor decorado posible. La profesionalidad de todo el equipo es indiscutible. En todo momento, atentos a todas tus necesidades. Los platos magistrales. De una calidad que te quedas boquiabierto. Aparte algunos platos muy elaborados que nada tienen que envidiar a alta cocina. Los invitados asombrados nos preguntaban que donde hab\u00edamos descubierto este sitio. Nuestra ceremonia y boda fue un \u00e9xito y en parte es debido a ellos. Muchas gracias por el d\u00eda tan estupendo que pasamos con vosotros!!!","author":{"@type":"Person","name":"Charles P."},"reviewRating":{"@type":"Rating","ratingValue":"4.8","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2024-04-07","description":"Desde el principio fueron muy amables, tuvieron mucha paciencia con nuestras preguntas y nos facilitaron cualquier cosa que quisi\u00e9ramos. Durante la boda han sido puntuales como un reloj, la comida estaba buen\u00edsima, el servicio ha sido coordinado, y todos los invitados han quedado encantados con todo. Menci\u00f3n especial a la mesa se dulces y al resop\u00f3n, que vol\u00f3 en cuesti\u00f3n de minutos.","author":{"@type":"Person","name":"Ana F."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2023-12-27","description":"Nos la jugamos cuando contratamos con ellos, ya que no estaba ni hecha todav\u00eda. Y fue una apuesta segura. El lugar es incre\u00edble, la comida ESPECTACULAR, que tengan cocina propia siempre es un acierto. Mar\u00eda es un encanto, cada cosa que le ped\u00edamos o habl\u00e1bamos con ella siempre intentaba si no pod\u00eda concederlo, hacer lo posible para que fuera lo que nosotros quer\u00edamos. Esos detalles son de valorar, ya que tu boda es tuya y encontrar un sitio en el que puedes llegar a entendimientos y que sea tu boda so\u00f1ada es importante. Muy atentos siempre de nosotros, dicen que los novios en una boda son los que menos comen? No aqu\u00ed, no paraban de preguntarnos si hab\u00edamos comido y traernos comida. En resumen, un 10.","author":{"@type":"Person","name":"Andrea P."},"reviewRating":{"@type":"Rating","ratingValue":"4.6","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2023-12-11","description":"Sin duda no nos equivocamos a la hora de escoger este lugar para celebrar nuestra boda porque fue todo incre\u00edble! No tengo palabras para describir como me sent\u00ed ese d\u00eda y lo bien que fue todo, siempre nos dieron todas las facilidades para ese dia y para que todo fuese como hab\u00edamos so\u00f1ado, pero se superaron! Lo recomiento 100%","author":{"@type":"Person","name":"Patricia R."},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2023-12-08","description":"Tanto la comida, la coordinaci\u00f3n del evento, la belleza del lugar y la facilitaci\u00f3n y adaptaci\u00f3n por parte de la mas\u00eda a los detalles del tipo de fiesta que quer\u00edamos han sido espectaculares. Recomiendo 100%","author":{"@type":"Person","name":"Celia"},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2023-10-16","description":"\u00a1Increible! Es la palabra 'resumen' que podria definir esta masia. Un lugar de ensue\u00f1o para poder celebrar un gran d\u00eda como es tu boda. Desde el primer momento que empezamos con la organizaci\u00f3n ha sido todo tal y como so\u00f1amos. Lo llevan todo al absoluto detalle, atenci\u00f3n y organizaci\u00f3n perfecta. El servicio de sal\u00f3n es perfecto, todos los camareros super atentos. La comida tiene una calidad 10\/10. Solo tenemos palabras buenas para la mas\u00eda, pero sobre todo para mar\u00eda, persona que deslumbra, amable, atenta, sincera y detallista con todo. Hace todo lo posible por qu\u00e9 tu d\u00eda sea inolvidable, aconsejando y dando apoyo en todo. \u00a1Muchas gracias por todo!","author":{"@type":"Person","name":"Thais"},"reviewRating":{"@type":"Rating","ratingValue":"5.0","bestRating":5,"worstRating":0}},{"@type":"Review","datePublished":"2023-10-10","description":"Nuestra boda fue el 16 de septiembre, aunque el tiempo no acompa\u00f1\u00f3 mucho lo otro fue tan perfecto que es como si hubiese salido el sol por parte de la organizaci\u00f3n de Mar\u00eda no tenemos queja es una chica muy familiar y profesional, por la parte que complementa a un evento es la comida que no tenemos ninguna queja todo lo contrario cada bocadito que peg\u00