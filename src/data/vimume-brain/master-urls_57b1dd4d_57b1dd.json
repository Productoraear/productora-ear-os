import os
import subprocess
import time

SYNC_FILE = "EAR_OS_SYNC.json"

def execute_command(command):
    print(f"\n[🚀 SINAPSIS] Ejecutando: {command}")
    try:
        process = subprocess.Popen(command, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in process.stdout:
            print(f"  > {line.strip()}")
        process.wait()
        return process.returncode == 0
    except Exception as e:
        print(f"  ❌ Error: {str(e)}")
        return False

def run_synapse():
    print("🧠 MOTOR DE SINAPSIS EAR ACTIVADO - MODO YOLO GLOBAL")
    last_processed_task = ""
    while True:
        try:
            if os.path.exists(SYNC_FILE):
                with open(SYNC_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                pending_tasks = data.get("active_sprints", {}).get("execution_queue", [])
                for task in pending_tasks:
                    if task.get("id") != last_processed_task and task.get("status") == "PENDING":
                        success = execute_command(task["command"])
                        task["status"] = "COMPLETED" if success else "FAILED"
                        last_processed_task = task["id"]
                        with open(SYNC_FILE, "w", encoding="utf-8") as f:
                            json.dump(data, f, indent=2)
                        print(f"[✅] Tarea {task['id']} finalizada.")
            time.sleep(2)
        except Exception as e:
            print(f"⚠️ Error: {e}")
            time.sleep(5)

