import subprocess
import os
from pathlib import Path

LEGACY_JSON = Path("public/data/legacy_providers.json")
DB_FILE = Path("productoraear_proveedores_mega.db")

def get_mtime(path):
    if not path.exists(): return 0
    return os.path.getmtime(path)

if __name__ == "__main__":
    print("🚀 Watcher EAR V2 (YOLO Mode) Activo.")
    print("Monitorizando cambios en datos sin dependencias externas...")
    
    last_legacy = get_mtime(LEGACY_JSON)
    last_db = get_mtime(DB_FILE)
    
    try:
        while True:
            curr_legacy = get_mtime(LEGACY_JSON)
            curr_db = get_mtime(DB_FILE)
            
            if curr_legacy != last_legacy or curr_db != last_db:
                print("🔄 ¡Cambio detectado! Sincronizando Master Arsenal...")
                subprocess.run(["python", "ear_unity_matrix.py"])
                
                print("🌍 Optimizando SEO Masivo...")
                subprocess.run(["python", "ear_seo_generator.py"])
                
                print("🗺️ Actualizando Sitemap...")
                subprocess.run(["python", "ear_sitemap_generator.py"])
                
                last_legacy = curr_legacy
                last_db = curr_db
                print("✅ Ciclo de Actualización Completo.")
            
            time.sleep(5)
    except KeyboardInterrupt:
        print("Fin del Watcher.")
